# Read by the MCP server process. Never paste the token into a chat.
GITHUB_TOKEN=
# Comma-separated owner/repo pairs the watchlist resource exposes.
GITHUB_REPOS=owner/repo,owner/other
# Optional. Defaults to https://api.github.com
GITHUB_API_BASE_URL=https://api.github.com

# Used only when running `npm run dev:http` or `node dist/index.js --http`.
MCP_HTTP_PORT=3333

# Read by the CLI agent. They are not forwarded to the MCP server child process.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4
OPENAI_API_KEY=
