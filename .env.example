# Personal access token. Used only when no GitHub App variable below is set.
# Never paste the token into a chat.
GITHUB_TOKEN=
# Comma-separated owner/repo pairs the watchlist resource exposes.
GITHUB_REPOS=owner/repo,owner/other
# Optional. Defaults to https://api.github.com
GITHUB_API_BASE_URL=https://api.github.com

# GitHub App installation. Preferred when you set it.
# If any GITHUB_APP_* variable is set, the App id, the installation id, and exactly
# one private-key form are required. The server exits if that set is incomplete
# and does not fall back to GITHUB_TOKEN. A complete App wins when both are set.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# PEM contents. Use a literal \n where the file has a newline.
# Do not set this and GITHUB_APP_PRIVATE_KEY_PATH together.
# GITHUB_APP_PRIVATE_KEY=
# Path to the PEM downloaded from the App. An absolute path is the reliable form
# in a desktop host config. The process reads it at startup.
# GITHUB_APP_PRIVATE_KEY_PATH=

# Used only when running `npm run dev:http` or `node dist/index.js --http`.
MCP_HTTP_PORT=3333

# Read by the CLI agent. They are not forwarded to the MCP server child process.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4
OPENAI_API_KEY=
