{
  "name": "mcp-devops-agent",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for GitHub pull requests, CI, and issues, plus a TypeScript agent that calls it.",
  "type": "module",
  "license": "MIT",
  "author": "Humberto Vieira",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "devops-mcp": "./dist/index.js",
    "devops-agent": "./dist/agent/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjsvieira98/mcp-devops-agent.git"
  },
  "bugs": {
    "url": "https://github.com/hjsvieira98/mcp-devops-agent/issues"
  },
  "homepage": "https://github.com/hjsvieira98/mcp-devops-agent#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "agent": "tsx src/agent/cli.ts",
    "eval": "tsx src/evals/cli.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
